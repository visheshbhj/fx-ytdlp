<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.fx.ytdlp.MainController">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <top>
        <VBox spacing="8">
            <padding>
                <Insets bottom="12"/>
            </padding>
            <HBox spacing="8">
                <TextField fx:id="urlField" HBox.hgrow="ALWAYS" onAction="#onAdd"
                           promptText="Paste one or more URLs (space/newline separated)"/>
                <Button text="Add to queue" defaultButton="true" onAction="#onAdd"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ComboBox fx:id="presetBox"/>
                <Label text="Cover:"/>
                <ComboBox fx:id="coverBox"/>
                <CheckBox fx:id="playlistCheck" text="Whole playlist"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Save to:"/>
                <Label fx:id="outputDirLabel" maxWidth="260" textOverrun="LEADING_ELLIPSIS"/>
                <Button text="Change…" onAction="#onChooseDir"/>
            </HBox>
            <TitledPane fx:id="advancedPane" text="Advanced options" expanded="false" animated="false">
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <CheckBox fx:id="subtitlesCheck" text="Embed subtitles"
                              GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <tooltip><Tooltip text="Video formats only"/></tooltip>
                    </CheckBox>
                    <TextField fx:id="subLangsField" promptText="en"
                               GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <tooltip><Tooltip text="Comma separated language codes, e.g. en,de,ja (regex allowed; avoid en.* with auto-generated, it pulls every auto-translation)"/></tooltip>
                    </TextField>
                    <CheckBox fx:id="autoSubsCheck" text="Include auto-generated"
                              GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.columnSpan="2"/>

                    <Label text="SponsorBlock:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="sponsorBlockBox" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <CheckBox fx:id="chaptersCheck" text="Embed chapters"
                              GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <CheckBox fx:id="skipDownloadedCheck" text="Skip already downloaded"
                              GridPane.rowIndex="1" GridPane.columnIndex="3">
                        <tooltip><Tooltip text="Keeps a .fx-ytdlp-archive.txt in the output folder; handy for re-syncing playlists"/></tooltip>
                    </CheckBox>

                    <Label text="Speed limit:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="speedLimitField" promptText="unlimited (e.g. 5M, 500K)"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Cookies from:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="cookiesBox" GridPane.rowIndex="2" GridPane.columnIndex="3">
                        <tooltip><Tooltip text="Use your browser login, for age-restricted or members-only videos"/></tooltip>
                    </ComboBox>

                    <Label text="Filename:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <HBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3">
                        <TextField fx:id="templateField" HBox.hgrow="ALWAYS">
                            <tooltip><Tooltip text="yt-dlp output template, relative to the Save to folder"/></tooltip>
                        </TextField>
                        <Button text="Reset" onAction="#onResetTemplate"/>
                    </HBox>

                    <Label text="Extra args:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="extraArgsField" promptText="any other yt-dlp options, e.g. --no-mtime --geo-bypass"
                               GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                </GridPane>
            </TitledPane>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Queue is empty"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="titleCol" text="Title" prefWidth="300"/>
                <TableColumn fx:id="presetCol" text="Format" prefWidth="130"/>
                <TableColumn fx:id="progressCol" text="Progress" prefWidth="120"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="90"/>
                <TableColumn fx:id="detailCol" text="Details" prefWidth="220"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12"/>
            </padding>
            <Label fx:id="versionLabel" text="yt-dlp: checking…"/>
            <Button fx:id="updateButton" text="Update yt-dlp" onAction="#onUpdate" disable="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Clear finished" onAction="#onClearFinished"/>
        </HBox>
    </bottom>
</BorderPane>
